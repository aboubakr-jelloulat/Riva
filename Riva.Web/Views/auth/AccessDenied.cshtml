﻿@{
    ViewData["Title"] = "Access Denied";
}

@section Styles {
    <style>
        body {
            background-color: #f8f9fa;
        }
        .access-denied-container {
            min-height: 80vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .icon-wrapper {
            width: 120px;
            height: 120px;
            background: rgba(220, 53, 69, 0.1);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 2rem;
        }
        .error-card {
            border: none;
            border-radius: 24px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.08);
            background: white;
            overflow: hidden;
            position: relative;
        }
        .error-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 6px;
            background: linear-gradient(90deg, #dc3545, #fd7e14);
        }
    </style>
}

<div class="container access-denied-container py-5">
    <div class="row justify-content-center w-100">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card error-card">
                <div class="card-body p-5 text-center">
                    
                    <div class="icon-wrapper">
                        <i class="bi bi-shield-lock-fill text-danger text-gradient" style="font-size: 4rem;"></i>
                    </div>

                    <h2 class="fw-bold text-dark mb-3">Access Denied</h2>
                    <p class="text-muted fs-5 mb-4 px-3">
                        Oops! You don't have permission to view this page. If you believe this is a mistake, please contact support.
                    </p>

                    <div class="d-flex justify-content-center gap-3 mt-4">
                        <a href="javascript:history.back()" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-medium">
                            <i class="bi bi-arrow-left me-2"></i> Go Back
                        </a>
                        <a asp-action="Index" asp-controller="Home" class="btn btn-primary rounded-pill px-4 py-2 fw-medium shadow-sm">
                            <i class="bi bi-house-door me-2"></i> Home Page
                        </a>
                    </div>
                    
                </div>
            </div>
        </div>
    </div>
</div>
