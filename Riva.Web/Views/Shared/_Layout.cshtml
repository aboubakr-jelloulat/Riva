<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Riva.Web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Riva.Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f8f9fa; }
        .navbar { background: rgba(255, 255, 255, 0.9) !important; backdrop-filter: blur(10px); }
        .nav-link { font-weight: 500; transition: all 0.3s ease; }
        .nav-link:hover { color: #0d6efd !important; transform: translateY(-1px); }
        .btn-auth { border-radius: 50px; padding: 0.5rem 1.5rem; transition: all 0.3s ease; font-weight: 600; }
        .btn-auth:hover { transform: translateY(-2px); box-shadow: 0 4px 12px rgba(13, 110, 253, 0.2); }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-4 sticky-top">
            <div class="container-fluid px-lg-4">
                <a class="navbar-brand fw-bold fs-4 text-primary d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-buildings-fill me-2"></i> Riva
                </a>
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between align-items-center">
                    <ul class="navbar-nav flex-grow-1 mx-lg-4">
                        <li class="nav-item">
                            <a class="nav-link text-dark px-3" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark px-3" asp-area="" asp-controller="Villa" asp-action="Index">
                                <i class="bi bi-building-gear me-1"></i> Villa Management
                            </a>
                        </li>
                    </ul>
                    <ul class="navbar-nav align-items-center gap-2 mt-3 mt-sm-0">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark d-flex align-items-center" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 35px; height: 35px;">
                                        <i class="bi bi-person-fill"></i>
                                    </div>
                                    <span class="fw-medium">@User.Identity.Name</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="userDropdown" style="border-radius: 12px;">
                                    <li>
                                        <a class="dropdown-item py-2 text-danger fw-medium" asp-controller="auth" asp-action="Logout">
                                            <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark fw-medium px-3" asp-controller="auth" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary text-white btn-auth shadow-sm" asp-controller="auth" asp-action="Register">
                                    <i class="bi bi-person-plus me-1"></i> Get Started
                                </a>
                            </li>
                        } 
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <main role="main" class="pb-5">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted bg-white mt-auto py-4">
        <div class="container text-center">
            <div class="mb-2">
                <i class="bi bi-buildings-fill text-primary fs-4"></i>
            </div>
            &copy; 2026 - Riva.Web - <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-decoration-none fw-medium">Privacy Policy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
