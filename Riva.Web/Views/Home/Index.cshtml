@using Riva.DTO
@using Riva.Web.Shared

@model IEnumerable<VillaDTO>

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}


<section class="riva-hero" id="riva-hero" aria-label="Hero Carousel">

    <!-- Slide track -->
    <div class="riva-carousel-track" id="rivaTrack">

        <div class="riva-slide active">
            <img src="~/Images/home/italy.webp" alt="Scenic Italian Villa" loading="eager" />
        </div>

        <div class="riva-slide">
            <img src="~/Images/home/salon-villa-royale.webp" alt="Villa Royale Salon" loading="lazy" />
        </div>

        <div class="riva-slide">
            <img src="~/Images/home/bellaria.webp" alt="Bellaria Villa" loading="lazy" />
        </div>

        <div class="riva-slide">
            <img src="~/Images/home/arrighi.webp" alt="Arrighi Villa" loading="lazy" />
        </div>

        <div class="riva-slide">
            <img src="~/Images/home/tisciano-new.webp" alt="Tisciano Villa" loading="lazy" />
        </div>

    </div>

    <!-- Caption  -->
    <div class="riva-hero-caption" id="rivaCaption">
        <span class="riva-eyebrow">Welcome to Riva</span>
